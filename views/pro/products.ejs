
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Products Dashboard</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
            rel="stylesheet">
        <style>
        body {
            background-color: #f8f9fa;
            color: #343a40;
        }
        /* .content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s;
        } */
.content {
        margin-left: 200px;
        padding: 40px 20px;
        min-height: 100vh;
        transition: margin-left 0.3s ease;
      }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: all 0.3s;
        }
        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
        }
        .btn-custom {
            border-radius: 20px;
            padding: 8px 20px;
            transition: all 0.3s;
        }
        .btn-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        .table {
            background-color: #fff;
            border-radius: 15px;
            overflow: hidden;
        }
        .table th {
            background-color: #007bff;
            color: #fff;
        }
        .pagination .page-link {
            border-radius: 20px;
            margin: 0 3px;
        }
        </style>
    </head>
    <body>
        <div class="content">
            <div class="container">
                <div
                    class="d-flex justify-content-between align-items-center mb-4">
                    <h2 class="mb-0">Products</h2>
                    <a href="/admin/products/add-product"
                        class="btn btn-primary btn-custom">
                        <i class="fas fa-plus me-2"></i>Add Product
                    </a>
                </div>
                <div class="mb-3">
                    <input type="text" id="searchInput" class="form-control"
                        placeholder="Search products..."
                        value="<%= search || '' %>">
                </div>
                <div id="products-content">
                    <% if (products.length > 0) { %>
                    <div class="card">
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Product Name</th>
                                            <th>Brand</th>
                                            <th>Price</th>
                                            <th>Category</th>
                                            <th>Sizes</th>
                                            <th>Stock</th>
                                            <th>Images</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% for (const pro of products) { %>
                                        <tr>
                                            <td><%= pro.product %></td>
                                            <td><%= pro.brand %></td>
                                            <td>₹<%= pro.price %></td>
                                            <td><%= pro.category.name %></td>
                                            <td>
                                                <% if (pro.sizes.length > 0) {
                                                %>
                                                <ul class="list-unstyled mb-0">
                                                    <% for (const size of
                                                    pro.sizes) { %>
                                                    <li><%= size.size %></li>
                                                    <% } %>
                                                </ul>
                                                <% } else { %>
                                                <span class="text-muted">No
                                                    sizes</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (pro.sizes.length > 0) {
                                                %>
                                                <ul class="list-unstyled mb-0">
                                                    <% for (const size of
                                                    pro.sizes) { %>
                                                    <li><%= size.stock %></li>
                                                    <% } %>
                                                </ul>
                                                <% } else { %>
                                                <span class="text-muted">No
                                                    stock</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <img
                                                    src="<%= pro.images[0].secured_url %>"
                                                    alt="Product Image"
                                                    class="img-thumbnail"
                                                    style="max-width: 100px;">
                                            </td>
                                            <td>
                                                <div class="btn-group"
                                                    role="group">
                                                    <a
                                                        href="/admin/products/edit/<%= pro._id %>"
                                                        class="btn btn-warning btn-sm btn-custom">
                                                        <i
                                                            class="fas fa-edit"></i>
                                                        Edit
                                                    </a>
                                                    <form
                                                        action="/admin/products/<%= pro.isListed ? 'unlist-product' : 'list-product' %>/<%= pro._id %>"
                                                        method="post"
                                                        class="d-inline-block"
                                                        id="form-<%= pro._id %>">
                                                        <button type="submit"
                                                            class="btn <%= pro.isListed ? 'btn-danger' : 'btn-success' %> btn-sm btn-custom ms-2">
                                                            <i
                                                                class="fas <%= pro.isListed ? 'fa-times-circle' : 'fa-check-circle' %> me-1"></i>
                                                            <%= pro.isListed ?
                                                            'Unlist' : 'List' %>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                        <% } %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            <% for (let i = 1; i <= totalPages; i++) { %>
                            <li
                                class="page-item <%= i === currentPage ? 'active' : '' %>">
                                <a class="page-link" data-page="<%= i %>"><%= i
                                    %></a>
                            </li>
                            <% } %>
                        </ul>
                    </nav>
                    <% } else { %>
                    <div class="alert alert-info" role="alert">
                        <i class="fas fa-info-circle me-2"></i> No products
                        available
                    </div>
                    <% } %>
                </div>
            </div>
        </div>

        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            function debounce(func, delay) {
                let timer;
                return function(...args) {
                    clearTimeout(timer);
                    timer = setTimeout(() => func.apply(this, args), delay);
                };
            }

            async function fetchProducts(page = 1, search = '') {
                try {
                    const response = await fetch(`/admin/products/data?page=${page}&search=${encodeURIComponent(search)}`);
                    if (!response.ok) {
                        throw new Error('Failed to fetch products');
                    }
                    const data = await response.json();
                    updateContent(data);

                    const newUrl = `?page=${page}&search=${encodeURIComponent(search)}`;
                    history.pushState({ page, search }, '', newUrl);
                } catch (error) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to load products. Please try again.',
                        confirmButtonText: 'OK'
                    });
                }
            }

            function updateContent(data) {
                let html = '';
                if (data.products.length > 0) {
                    html += `
                        <div class="card">
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Product Name</th>
                                                <th>Brand</th>
                                                <th>Price</th>
                                                <th>Category</th>
                                                <th>Sizes</th>
                                                <th>Stock</th>
                                                <th>Images</th>
                                                <th>Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>`;
                    data.products.forEach(pro => {
                        html += `
                            <tr>
                                <td>${pro.product}</td>
                                <td>${pro.brand}</td>
                                <td>₹${pro.price}</td>
                                <td>${pro.category.name}</td>
                                <td>`;
                        if (pro.sizes.length > 0) {
                            html += '<ul class="list-unstyled mb-0">';
                            pro.sizes.forEach(size => {
                                html += `<li>${size.size}</li>`;
                            });
                            html += '</ul>';
                        } else {
                            html += '<span class="text-muted">No sizes</span>';
                        }
                        html += `</td>
                                <td>`;
                        if (pro.sizes.length > 0) {
                            html += '<ul class="list-unstyled mb-0">';
                            pro.sizes.forEach(size => {
                                html += `<li>${size.stock}</li>`;
                            });
                            html += '</ul>';
                        } else {
                            html += '<span class="text-muted">No stock</span>';
                        }
                        html += `</td>
                                <td><img src="${pro.images[0].secured_url}" alt="Product Image" class="img-thumbnail" style="max-width: 100px;"></td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a href="/admin/products/edit/${pro._id}" class="btn btn-warning btn-sm btn-custom">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <form action="/admin/products/${pro.isListed ? 'unlist-product' : 'list-product'}/${pro._id}" method="post" class="d-inline-block" id="form-${pro._id}">
                                            <button type="submit" class="btn ${pro.isListed ? 'btn-danger' : 'btn-success'} btn-sm btn-custom ms-2">
                                                <i class="fas ${pro.isListed ? 'fa-times-circle' : 'fa-check-circle'} me-1"></i>
                                                ${pro.isListed ? 'Unlist' : 'List'}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>`;
                    });
                    html += `
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <nav aria-label="Page navigation" class="mt-4">
                            <ul class="pagination justify-content-center">`;
                    for (let i = 1; i <= data.totalPages; i++) {
                        html += `
                            <li class="page-item ${i === data.currentPage ? 'active' : ''}">
                                <a class="page-link" data-page="${i}">${i}</a>
                            </li>`;
                    }
                    html += `</ul></nav>`;
                } else {
                    html += `
                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i> No products available
                        </div>`;
                }
                document.getElementById('products-content').innerHTML = html;

                attachFormListeners();
                attachPaginationListeners();
            }

            function attachFormListeners() {
                document.querySelectorAll('form[id^="form-"]').forEach(form => {
                    form.addEventListener('submit', async (event) => {
                        event.preventDefault();
                        const url = form.action;
                        try {
                            const response = await fetch(url, { method: 'POST' });
                            const result = await response.json();
                            if (response.ok) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Success!',
                                    text: result.message || 'Operation successful.',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    const search = document.getElementById('searchInput').value.trim();
                                    const currentPage = parseInt(new URLSearchParams(window.location.search).get('page')) || 1;
                                    fetchProducts(currentPage, search);
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Oops...',
                                    text: result.message || 'Something went wrong.',
                                    confirmButtonText: 'OK'
                                });
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'An error occurred. Please try again.',
                                confirmButtonText: 'OK'
                            });
                        }
                    });
                });
            }

            function attachPaginationListeners() {
                document.querySelectorAll('.page-link').forEach(link => {
                    link.addEventListener('click', (event) => {
                        event.preventDefault();
                        const page = parseInt(link.getAttribute('data-page'));
                        const search = document.getElementById('searchInput').value.trim();
                        fetchProducts(page, search);
                    });
                });
            }

            const searchInput = document.getElementById('searchInput');
            searchInput.addEventListener('keyup', debounce(() => {
                const searchTerm = searchInput.value.trim();
                fetchProducts(1, searchTerm);
            }, 500));

            attachFormListeners();
            attachPaginationListeners();
        </script>
    </body>
</html>