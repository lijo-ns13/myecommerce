<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= product.product %> - Product Detail</title>
        <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
            rel="stylesheet">
        <link
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
            rel="stylesheet">
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
            rel="stylesheet">
        <style>
        :root {
            --primary-color: #2563eb;
            --secondary-color: #dc2626;
            --accent-color: #f59e0b;
            --background-color: #f8fafc;
            --text-color: #1e293b;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            line-height: 1.5;
        }

        .product-detail {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2.5rem;
            margin-bottom: 2rem;
        }

        .main-image-container {
            position: relative;
            overflow: hidden;
            border-radius: 8px;
            aspect-ratio: 4/3;
            cursor: zoom-in;
        }

        .main-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .main-image-container:hover img {
            transform: scale(1.05);
        }

        .thumbnail-images {
            margin-top: 1rem;
        }

        .thumbnail {
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 6px;
            transition: all 0.3s ease;
        }

        .thumbnail.active {
            border-color: var(--primary-color);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .thumbnail:hover {
            transform: translateY(-3px);
        }

        .product-title {
            font-size: 1.875rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .product-rating {
            font-size: 1rem;
            margin-bottom: 1rem;
            color: #f59e0b;
        }

        .product-price {
            font-size: 1.75rem;
            font-weight: 600;
            color: var(--primary-color);
            margin-bottom: 1rem;
        }

        .product-description {
            font-size: 1rem;
            line-height: 1.6;
            color: #4b5563;
            margin-bottom: 1.5rem;
        }

        .size-selection .btn {
            border-radius: 50px;
            padding: 0.5rem 1.25rem;
            font-weight: 500;
            margin-right: 0.5rem;
            margin-bottom: 0.5rem;
        }

        .size-selection .btn.active {
            background-color: var(--primary-color);
            color: #fff;
            border-color: var(--primary-color);
        }

        .action-buttons .btn {
            border-radius: 50px;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
        }

        .btn-primary:hover {
            background-color: #1d4ed8;
            transform: translateY(-2px);
        }

        .btn-outline-danger {
            border-color: var(--secondary-color);
            color: var(--secondary-color);
        }

        .btn-outline-danger:hover {
            background-color: var(--secondary-color);
            color: #fff;
            transform: translateY(-2px);
        }

        .reviews-container {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            padding: 2.5rem;
            margin-bottom: 2rem;
        }

        .reviews-containertwo {
            max-height: 400px;
            overflow-y: auto;
            padding: 1rem;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            background-color: #f9fafb;
        }

        .section-title {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 1.5rem;
            text-align: center;
        }

        .rating-summary {
            background: linear-gradient(135deg, var(--primary-color) 0%, #1d4ed8 100%);
            color: #fff;
            padding: 1.5rem;
            border-radius: 8px;
            text-align: center;
        }

        .rating-number {
            font-size: 3rem;
            font-weight: 700;
            line-height: 1;
        }

        .star-rating {
            font-size: 1.25rem;
            margin-bottom: 0.5rem;
        }

        .review-count {
            font-size: 0.875rem;
            opacity: 0.9;
        }

        .rating-bars {
            padding: 1.5rem;
            background-color: #f8fafc;
            border-radius: 8px;
        }

        .rating-bar {
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .progress {
            height: 0.75rem;
            background-color: #e5e7eb;
            border-radius: 10px;
            margin: 0 1rem;
        }

        .progress-bar {
            background-color: var(--primary-color);
        }

        .review-item {
            padding: 1rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .review-item:last-child {
            border-bottom: none;
        }

        .user-info {
            display: flex;
            align-items: center;
            margin-bottom: 0.75rem;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 0.75rem;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.875rem;
        }

        .review-date {
            font-size: 0.75rem;
            color: #6b7280;
        }

        .btn-review {
            display: inline-block;
            background-color: var(--primary-color);
            color: #fff;
            padding: 0.75rem 1.5rem;
            border-radius: 50px;
            text-decoration: none;
            font-weight: 500;
        }

        .btn-review:hover {
            background-color: #1d4ed8;
        }

        .related-products-section {
            padding: 3rem 0;
            background-color: #f8fafc;
        }

        .product-box {
            background-color: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .product-box:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        }

        .product-images {
            height: 200px;
            overflow: hidden;
            border-radius: 12px 12px 0 0;
        }

        .product-images img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .product-content {
            padding: 1.25rem;
        }

        .stock-status {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
            border-radius: 50px;
        }

        .in-stock {
            background-color: #22c55e;
            color: #fff;
        }

        .out-of-stock {
            background-color: var(--secondary-color);
            color: #fff;
        }

        @media (max-width: 991px) {
            .product-detail, .reviews-container {
                padding: 1.5rem;
            }

            .product-title {
                font-size: 1.5rem;
            }

            .product-price {
                font-size: 1.25rem;
            }
        }

        @media (max-width: 767px) {
            .main-image-container {
                height: 300px;
            }

            .thumbnail-images .col-3 {
                flex: 0 0 25%;
                max-width: 25%;
            }
        }

        @media (max-width: 575px) {
            .main-image-container {
                height: 250px;
            }

            .action-buttons .btn {
                width: 100%;
                margin-bottom: 0.5rem;
            }

            .rating-number {
                font-size: 2rem;
            }

            .star-rating {
                font-size: 1rem;
            }
        }
    </style>
        <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
        <script
            src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/elevatezoom/3.0.8/jquery.elevatezoom.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    </head>
    <body>
        <%- include('partials/userNav') %>
        <div class="container my-5">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb bg-transparent p-0 mb-3">
                    <li class="breadcrumb-item"><a href="/"
                            class="text-muted">Home</a></li>
                    <li class="breadcrumb-item"><a
                            href="/products?query=&category=<%=product.category._id%>&sort="
                            class="text-muted"><%= product.category.name
                            %></a></li>
                    <li class="breadcrumb-item active" aria-current="page"><%=
                        product.product %></li>
                </ol>
            </nav>

            <!-- Product Detail Section -->
            <div class="product-detail row">
                <div class="col-lg-6 mb-4">
                    <div class="main-image-container">
                        <img id="main-product-image"
                            src="<%= product.images[0].secured_url %>"
                            alt="<%= product.product %>" class="img-fluid">
                    </div>
                    <div class="thumbnail-images">
                        <div class="row g-2">
                            <% product.images.forEach((image, index) => { %>
                            <div class="col-3">
                                <img src="<%= image.secured_url %>"
                                    alt="<%= product.product %>"
                                    class="img-fluid thumbnail <%= index === 0 ? 'active' : '' %>"
                                    onclick="changeMainImage('<%= image.secured_url %>', <%= index %>)">
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <h1 class="product-title"><%= product.product %></h1>
                    <div class="product-rating">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <% if (i <= Math.floor(avgRating)) { %>
                        <i class="fas fa-star"></i>
                        <% } else if (i === Math.ceil(avgRating) && avgRating %
                        1 !== 0) { %>
                        <i class="fas fa-star-half-alt"></i>
                        <% } else { %>
                        <i class="far fa-star"></i>
                        <% } %>
                        <% } %>
                        <span class="ms-2 text-muted">(<%=
                            product.reviews.length %> reviews)</span>
                    </div>
                    <div class="product-price">
                        <% if(isOffer) { %>
                        <span
                            class="text-muted text-decoration-line-through">₹<%=
                            product.price.toFixed(2) %></span>
                        <span class="text-success">₹<%=
                            product.finalPrice.toFixed(2) %></span>
                        <span class="badge bg-danger ms-2">Sale</span>
                        <% } else { %>
                        <span class="text-success">₹<%=
                            product.finalPrice.toFixed(2) %></span>
                        <% } %>
                    </div>
                    <p class="product-description"><%= product.description
                        %></p>
                    <div class="size-selection mb-4">
                        <h5 class="mb-3">Select Size:</h5>
                        <% if (product.sizes.length > 0) { %>
                        <div class="size-buttons">
                            <% product.sizes.forEach(size => { %>
                            <button type="button"
                                class="btn btn-outline-secondary size-button"
                                data-size="<%= size.size %>"><%= size.size
                                %></button>
                            <% }) %>
                        </div>
                        <% } else { %>
                        <p class="text-muted">No sizes available</p>
                        <% } %>
                    </div>
                    <div class="action-buttons d-flex flex-wrap gap-2">
                        <form id="addToCartForm">
                            <input type="hidden" name="productId"
                                value="<%= product._id %>">
                            <input type="hidden" name="size" id="selectedSize">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-shopping-cart me-2"></i>Add to
                                Cart
                            </button>
                        </form>
                        <form id="wishlistForm">
                            <input type="hidden" name="productId" id="productId"
                                value="<%= product._id %>">
                            <button type="submit"
                                class="btn btn-outline-danger">
                                <i class="far fa-heart me-2"></i>Add to Wishlist
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="reviews-container">
                <h2 class="section-title">Customer Feedback</h2>
                <div class="row">
                    <div class="col-md-4 mb-4">
                        <div class="rating-summary">
                            <div class="rating-number"><%= avgRating %></div>
                            <div class="star-rating">
                                <% for (let i = 1; i <= 5; i++) { %>
                                <% if (i <= Math.floor(avgRating)) { %>
                                <i class="fas fa-star"></i>
                                <% } else if (i === Math.ceil(avgRating) &&
                                avgRating % 1 !== 0) { %>
                                <i class="fas fa-star-half-alt"></i>
                                <% } else { %>
                                <i class="far fa-star"></i>
                                <% } %>
                                <% } %>
                            </div>
                            <div class="review-count"><%= product.reviews.length
                                %> reviews</div>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="rating-bars">
                            <% for (let i = 5; i >= 1; i--) { %>
                            <div class="rating-bar">
                                <div class="bar-label"><%= i %> <i
                                        class="fas fa-star"></i></div>
                                <div class="progress">
                                    <%
                                    const countWithRatingI =
                                    product.reviews.filter(review =>
                                    review.rating === i).length;
                                    const percentage = product.reviews.length >
                                    0 ? (countWithRatingI /
                                    product.reviews.length) * 100 : 0;
                                    %>
                                    <div class="progress-bar"
                                        style="width: <%= percentage.toFixed(2) %>%"></div>
                                </div>
                                <div class="bar-value"><%=
                                    Math.round(percentage) %>%</div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
                <a href="/user/review/add/<%= product._id %>"
                    class="btn-review">Write a Review</a>
                <div class="reviews-containertwo mt-4">
                    <% if (product.reviews.length > 0) { %>
                    <% product.reviews.forEach(review => { %>
                    <div class="review-item" id="review-<%= review._id %>">
                        <div class="user-info">
                            <img
                                src="https://i.pravatar.cc/150?u=<%= review.user._id %>"
                                alt="User Avatar" class="user-avatar">
                            <div>
                                <div class="user-name"><%= review.user.name
                                    %></div>
                                <div class="star-rating">
                                    <% for (let i = 1; i <= 5; i++) { %>
                                    <% if (i <= review.rating) { %>
                                    <i class="fas fa-star"></i>
                                    <% } else { %>
                                    <i class="far fa-star"></i>
                                    <% } %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        <div class="review-date">
                            <%= new
                            Date(review.date).toLocaleDateString('en-US', {
                            year: 'numeric', month: 'long', day: 'numeric' }) %>
                        </div>
                        <p class="review-content"><%= review.comment %></p>
                        <% if (currentUserId && review.user && review.user._id
                        && review.user._id.toString() ===
                        currentUserId.toString()) { %>
                        <button class="btn btn-sm btn-danger btn-delete"
                            onclick="deleteReview('<%= review._id %>', '<%= product._id %>')">Delete</button>
                        <a href="/user/review/edit/<%= review._id %>"
                            class="btn btn-sm btn-warning btn-edit">Edit</a>
                        <% } %>
                    </div>
                    <% }) %>
                    <% } else { %>
                    <div class="no-reviews text-center">
                        <i class="fas fa-comment-alt fa-2x mb-3"></i>
                        <p>No reviews yet. Be the first to share your
                            thoughts!</p>
                    </div>
                    <% } %>
                </div>
            </div>

            <!-- Related Products Section -->
            <section class="related-products-section">
                <h2 class="section-title">Related Products</h2>
                <div class="product-grid row g-4">
                    <% for (const product of relatedProducts) { %>
                    <div class="col-md-4 col-sm-6">
                        <div class="product-box">
                            <a href="/product-detail/<%= product._id %>">
                                <div class="product-images"
                                    onmouseover="startSlideshow(this)"
                                    onmouseout="stopSlideshow(this)">
                                    <% for (const image of product.images) { %>
                                    <img src="<%= image.secured_url %>"
                                        alt="Product Image"
                                        class="img-fluid <%= image === product.images[0] ? 'active' : '' %>">
                                    <% } %>
                                </div>
                            </a>
                            <div class="product-content">
                                <h3 class="product-title"><%= product.product
                                    %></h3>
                                <div class="rating">
                                    <% for (let i = 0; i < 5; i++) { %>
                                    <span
                                        class="star <%= i < product.rating ? 'filled' : '' %>">★</span>
                                    <% } %>
                                </div>
                                <div class="price-container">
                                    <% if (product.offerApplied) { %>
                                    <span
                                        class="original-price text-muted text-decoration-line-through">$<%=
                                        product.price.toFixed(2) %></span>
                                    <span class="final-price text-success">$<%=
                                        product.finalPrice.toFixed(2) %></span>
                                    <span class="badge bg-danger ms-2"><%=
                                        ((product.price - product.finalPrice) /
                                        product.price * 100).toFixed(0) %>%
                                        off</span>
                                    <% } else { %>
                                    <span class="final-price text-success">$<%=
                                        product.price.toFixed(2) %></span>
                                    <% } %>
                                </div>
                                <span
                                    class="stock-status <%= product.sizes.some(size => size.stock > 0) ? 'in-stock' : 'out-of-stock' %>">
                                    <%= product.sizes.some(size => size.stock >
                                    0) ? 'In Stock' : 'Out of Stock' %>
                                </span>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </section>
        </div>

        <%- include('partials/footer') %>

        <script>
        $(document).ready(function() {
            // Initialize ElevateZoom
            $('#main-product-image').elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 200,
                scrollZoom: true,
                zoomWindowFadeIn: 300,
                zoomWindowFadeOut: 300
            });

            // Size selection
            $('.size-button').on('click', function() {
                const size = $(this).data('size');
                $('#selectedSize').val(size);
                $('.size-button').removeClass('active').addClass('btn-outline-secondary');
                $(this).addClass('active').removeClass('btn-outline-secondary');
            });

            // Add to cart
            $('#addToCartForm').on('submit', function(e) {
                e.preventDefault();
                const selectedSize = $('#selectedSize').val();
                if (!selectedSize) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Size Required',
                        text: 'Please select a size before adding to cart.',
                        confirmButtonText: 'OK'
                    });
                    return;
                }

                fetch('/cart/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        productId: $('input[name="productId"]').val(),
                        size: selectedSize
                    })
                })
                .then(response => {
                    if (response.status === 401) {
                        Swal.fire({
                            icon: 'warning',
                            title: 'Unauthorized',
                            text: 'You need to log in to add items to the cart.',
                            confirmButtonText: 'Login'
                        }).then(() => window.location.href = '/auth/signin');
                    } else if (response.status === 403) {
                        return response.json().then(data => {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Limit Reached',
                                text: data.message || 'Error occurred.',
                                confirmButtonText: 'OK'
                            });
                        });
                    } else if (response.ok) {
                        return response.json().then(data => {
                            Swal.fire({
                                icon: 'success',
                                title: 'Added to Cart',
                                text: data.message || 'Item added to cart successfully.',
                                confirmButtonText: 'OK'
                            });
                        });
                    } else {
                        throw new Error('Something went wrong');
                    }
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Oops!',
                        text: 'Please login to add to cart',
                        confirmButtonText: 'OK',
                        footer: '<a href="/auth/signin">Log in now!</a>'
                    });
                });
            });

            // Wishlist
            $('#wishlistForm').on('submit', function(e) {
                e.preventDefault();
                fetch(`/user/wishlist/add/${$('#productId').val()}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                })
                .then(response => response.json())
                .then(data => {
                    Swal.fire({
                        icon: data.success ? 'success' : 'info',
                        title: data.success ? 'Success!' : 'Oops!',
                        text: data.success ? 'Product added to wishlist' : 'This product is already in your wishlist!',
                        confirmButtonText: 'OK'
                    });
                })
                .catch(error => {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Oops',
                        text: 'Please login to add to wishlist',
                        confirmButtonText: 'OK'
                    });
                });
            });
        });

        // Change main image
        window.changeMainImage = function(imageUrl, index) {
            const mainImage = $('#main-product-image');
            mainImage.attr('src', imageUrl).data('zoom-image', imageUrl);
            $('.thumbnail').removeClass('active');
            $('.thumbnail').eq(index).addClass('active');
            $('.zoomLens').remove();
            mainImage.elevateZoom({
                zoomType: "lens",
                lensShape: "round",
                lensSize: 200,
                scrollZoom: true,
                zoomWindowFadeIn: 300,
                zoomWindowFadeOut: 300
            });
        };

        // Related products slideshow
        function startSlideshow(element) {
            element.slideshowInterval = setInterval(() => {
                const images = element.querySelectorAll('img');
                const activeImage = element.querySelector('img.active');
                const nextImage = activeImage.nextElementSibling || images[0];
                activeImage.classList.remove('active');
                nextImage.classList.add('active');
            }, 1000);
        }

        function stopSlideshow(element) {
            clearInterval(element.slideshowInterval);
            const images = element.querySelectorAll('img');
            images.forEach((img, index) => img.classList.toggle('active', index === 0));
        }

        // Delete review
        function deleteReview(reviewId, productId) {
            Swal.fire({
                title: 'Are you sure?',
                text: 'Do you really want to delete this review?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#2563eb',
                cancelButtonColor: '#dc2626',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'No, keep it'
            }).then((result) => {
                if (result.isConfirmed) {
                    fetch(`/user/review/delete/${reviewId}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId })
                    })
                    .then(response => {
                        if (response.ok) {
                            return response.json();
                        }
                        throw new Error('Failed to delete review');
                    })
                    .then(data => {
                        Swal.fire('Deleted!', 'Your review has been deleted.', 'success');
                        $(`#review-${reviewId}`).remove();
                        if ($('.review-item').length === 0) {
                            $('#reviewsList').html('<div class="no-reviews text-center"><i class="fas fa-comment-alt fa-2x mb-3"></i><p>No reviews yet. Be the first to share your thoughts!</p></div>');
                        }
                    })
                    .catch(error => {
                        Swal.fire('Error!', error.message, 'error');
                    });
                }
            });
        }
    </script>
    </body>
</html>